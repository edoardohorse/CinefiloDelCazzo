{
  "name": "@cinefilodelcazzo/backend",
  "version": "1.0.0",
  "description": "REST API for film management with Swagger documentation",
  "keywords": [
    "backend"
  ],
  "license": "ISC",
  "author": "Edoardo Cavallo",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start_debug": "node --inspect-brk --experimental-transform-types src/server.ts",
    "dev": "node --experimental-transform-types src/server.ts",
    "swagger": "node --experimental-transform-types src/generate-swagger.ts"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6",
    "sqlite": "^5.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "@cinefilodelcazzo/types": "../types"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.4.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  }
}
